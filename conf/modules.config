/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'NANOPLOT' {
        publishDir = [
            path: { "${params.outdir}/qc/nanoplot/${meta.id}" },
            mode: params.publish_dir_mode,
            pattern: '*.{html,txt}'
        ]
    }

    withName: AUTOCYCLER_SUBSAMPLE {
        ext.args      = { [
            "--min_read_depth ${params.min_read_depth}",
            params.assembler_mode?.toString()?.toLowerCase() == 'fast' ? '--count 2' : ''
        ].join(' ').trim() }
        errorStrategy = 'ignore'
    }

    withName: AUTOCYCLER_GENOMESIZE {
        errorStrategy = 'ignore'
    }

    withName: 'AUTOCYCLER_METAMDBGFILTER' {
        ext.prefix = { "${meta.id}_metamdbg" }
        publishDir = [
            path: { "${params.outdir}/autocycler/assemblies" },
            mode: params.publish_dir_mode,
            pattern: '*.{gfa,fasta}'
        ]
    }

    withName: AUTOCYCLER_MINIASM {
        ext.prefix = { "${meta.id}.miniasm" }
        publishDir = [
            path: { "${params.outdir}/autocycler/assemblies" },
            mode: params.publish_dir_mode,
            pattern: '*.{gfa,fasta}'
        ]
    }

    withName: AUTOCYCLER_PLASSEMBLER {
        ext.singularity_pull_docker_container = false
        errorStrategy = 'ignore'
        publishDir = [
            path: { "${params.outdir}/autocycler/assemblies" },
            mode: params.publish_dir_mode,
            pattern: '*.{gfa,fasta}'
        ]
    }

    withName: 'AUTOCYCLER_CLUSTER' {
        publishDir = [
            path: { "${params.outdir}/autocycler/clustering" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: AUTOCYCLER_MYLOASM {
        ext.prefix    = { "${meta.id}.myloasm" }
        ext.args      = '--min_depth_rel 0.1'
        errorStrategy = 'ignore'
        time          = 4.h
        publishDir = [
            path: { "${params.outdir}/autocycler/assemblies" },
            mode: params.publish_dir_mode,
            pattern: '*.fasta'
        ]
    }

    withName: STAGEASSEMBLIES {
        publishDir = [ enabled: false ]
    }

    withName: 'SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}.sorted" }
    }

    withName: 'SAMTOOLS_ADDREPLACERG' {
        ext.prefix = { "${meta.id}.rg" }
    }

    withName: 'AUTOCYCLER_COMBINE' {
        publishDir = [
            [
                path: { "${params.outdir}/autocycler/combine" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                path: { "${params.outdir}/autocycler/metrics" },
                mode: params.publish_dir_mode,
                pattern: '**/*.yaml',
                saveAs: { filename -> "${meta.id}_consensus_assembly.yaml" }
            ]
        ]
    }

    withName: 'AUTOCYCLER_COMPRESS' {
        publishDir = [
            path: { "${params.outdir}/autocycler/compress" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'AUTOCYCLER_CLEAN' {
        ext.args = '-m 1'
        publishDir = [
            path: { "${params.outdir}/autocycler/clustering" },
            mode: params.publish_dir_mode,
            pattern: '*.cleaned.gfa'
        ]
    }

    withName: AUTOCYCLER_CANU {
        ext.prefix    = { "${meta.id}.canu" }
        errorStrategy = 'ignore'
        publishDir = [
            path: { "${params.outdir}/autocycler/assemblies" },
            mode: params.publish_dir_mode,
            pattern: '*.fasta'
        ]
    }

    withName: 'DORADO_POLISH' {
        maxForks = 1
    }

    withName: 'AUTOCYCLER_TABLE' {
        publishDir = [
            path: { "${params.outdir}/autocycler/metrics/samples" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }
        withName: 'DORADO_BASECALLER' {
        ext.args         = '--device cuda:all'
        cpus             = 8
        memory           = 30.GB
    }

    withName: 'QSFILTER' {
        cpus   = 2
        memory = 15.GB
    }

    withName: 'DORADO_DEMUX' {
        memory     = 15.GB
        // Keep the per-barcode BAMs, as wf-basecalling does (out_dir/demuxed/...)
        publishDir = [
            path: { "${params.outdir}/basecalling" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'BASECALLSTATS' {
        cpus = 4
    }

    withName: 'BASECALLREPORT' {
        // Rewritten after every chunk, so it can be opened while basecalling runs
        publishDir = [
            path: { "${params.outdir}/basecalling" },
            mode: 'copy',
            overwrite: true
        ]
    }

    withName: 'STOPCONDITION' {
        // --watch_path --read_limit: the STOP file goes into the POD5 folder being watched
        publishDir = [
            path: { params.input },
            mode: 'copy',
            pattern: 'STOP.*'
        ]
    }
}