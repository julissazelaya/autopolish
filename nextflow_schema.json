{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/nf-core/autopolish//nextflow_schema.json",
    "title": "nf-core/autopolish pipeline parameters",
    "description": "Automated end-to-end assembly of bacterial genomes from Oxford Nanopore Technology (ONT) long-read sequencing data.",
    "type": "object",
    "$defs": {
        "input_output_options": {
            "title": "Input/output Options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Define where the pipeline should find input data and save output data.",
            "required": ["input", "input_type"],
            "properties": {
                "input": {
                    "type": "string",
                    "format": "path",
                    "exists": true,
                    "description": "Input folder: POD5s (pod5), BAMs (bam), FASTQs (fastq), or a wf-basecalling output folder (wf_basecalling).",
                    "fa_icon": "fas fa-folder-open"
                },
                "input_type": {
                    "type": "string",
                    "enum": ["fastq", "pod5", "bam", "wf_basecalling"],
                    "description": "Input file type: fastq, pod5, bam, or wf_basecalling"
                },
                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "The output directory where the results will be saved. Derived from --run_name and --analysis_base if not set directly.",
                    "fa_icon": "fas fa-folder-open"
                },
                "run_name": {
                    "type": "string",
                    "description": "Short name for this run. Combined with --analysis_base to build --outdir when --outdir is not set directly, e.g. --run_name fragmented_rerun."
                },
                "analysis_base": {
                    "type": "string",
                    "format": "directory-path",
                    "default": "/mrsnStorage/projects/Autopolish/analysis",
                    "description": "Base directory under which run-specific output folders are created when using --run_name."
                },
                "run_sheet": {
                    "type": "string",
                    "format": "file-path",
                    "exists": true,
                    "pattern": "^\\S+\\.(xlsx|csv)$",
                    "description": "MinION/PromethION run sheet (.xlsx as the lab fills it in) or a sample sheet .csv",
                    "fa_icon": "fas fa-file-excel"
                },
                "basecaller_cfg": {
                    "type": "string",
                    "default": "dna_r10.4.1_e8.2_400bps_sup@v5.2.0",
                    "description": "Dorado model name (as in wf-basecalling)",
                    "fa_icon": "fas fa-microchip"
                },
                "basecaller_model_path": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Dorado model folder; overrides basecaller_cfg",
                    "fa_icon": "fas fa-folder-open"
                },
                "barcode_kit": {
                    "type": "string",
                    "pattern": "^(SQK|EXP)-[A-Z0-9]+(-[0-9]+)?$",
                    "description": "Barcoding kit; defaults to the run sheet's 'Barcoding Kit:'",
                    "fa_icon": "fas fa-barcode"
                },
                "basecaller_chunk_size": {
                    "type": "integer",
                    "default": 25,
                    "minimum": 1,
                    "description": "POD5 files per Dorado task",
                    "fa_icon": "fas fa-layer-group"
                },
                "qscore_filter": {
                    "type": "number",
                    "default": 10,
                    "minimum": 0,
                    "description": "Reads with a mean Q-score below this are not demultiplexed or assembled",
                    "fa_icon": "fas fa-filter"
                },
                "watch_path": {
                    "type": "boolean",
                    "default": false,
                    "description": "Keep basecalling new POD5s as the run writes them (stop with --read_limit or the STOP file)",
                    "fa_icon": "fas fa-eye"
                },
                "read_limit": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "With --watch_path: stop watching once this many reads are called",
                    "fa_icon": "fas fa-hand-paper"
                }
            }    
        },
        "genome_assembly": {
            "title": "Genome Assembly",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "assembler_mode": {
                    "type": "string",
                    "default": "standard",
                    "enum": ["standard", "extended", "fast"],
                    "description": "Assemblers to run: standard (Flye, metaMDBG, miniasm, Raven on 4 read subsets plus Plassembler; 17 assemblies per sample), extended (standard plus Canu; 21) or fast (Flye, metaMDBG, miniasm, Myloasm, Plassembler, Raven on 2 read subsets, as autocycler_fast.sh; 12)"
                },
                "min_read_depth": {
                    "type": "integer",
                    "default": 50,
                    "description": "Minimum read depth for assembly"
                },
                "read_type": {
                    "type": "string",
                    "default": "ont_r10",
                    "description": "Read type passed to assemblers"
                },
                "flye_mode": {
                    "type": "string",
                    "default": "--nano-hq",
                    "description": "Flye assembly mode flag"
                },
                "metamdbg_input_type": {
                    "type": "string",
                    "default": "ont",
                    "description": "metaMDBG input type"
                },
                "plassembler_db": {
                    "type": "string",
                    "default": "/mrsnStorage/resources/plassembler",
                    "description": "Path to Plassembler database"
                }
            }
        },
        "genome_alignment": {
            "title": "Genome Alignment",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "rg_tag": {
                    "type": "string",
                    "default": "ID:A\\\\tDS:basecall_model=dna_r10.4.1_e8.2_400bps_sup@v5.2.0",
                    "description": "Read group tag for BAM header"
                }
            }
        },
        "resources": {
            "title": "Resources",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "threads": {
                    "type": "integer",
                    "default": 96
                }
            }
        },
        "boilerplate": {
            "title": "Boilerplate",
            "type": "object",
            "description": "",
            "default": "",
            "properties": {
                "publish_dir_mode": {
                    "type": "string",
                    "default": "copy",
                    "description": "Method for publishing results to output directory"
                },
                "email": {
                    "type": "string",
                    "description": "Email address for completion notification"
                },
                "email_on_fail": {
                    "type": "string",
                    "description": "Email address for failure notification"
                },
                "plaintext_email": {
                    "type": "boolean",
                    "description": "Send plain-text email instead of HTML"
                },
                "monochrome_logs": {
                    "type": "boolean",
                    "description": "Disable ANSI colour in log output"
                },
                "hook_url": {
                    "type": "string",
                    "description": "Slack or Teams hook URL for notifications"
                },
                "pipelines_testdata_base_path": {
                    "type": "string",
                    "default": "https://raw.githubusercontent.com/nf-core/test-datasets/"
                },
                "config_profile_name": {
                    "type": "string"
                },
                "config_profile_description": {
                    "type": "string"
                },
                "custom_config_version": {
                    "type": "string",
                    "default": "master"
                },
                "custom_config_base": {
                    "type": "string",
                    "default": "https://raw.githubusercontent.com/nf-core/configs/master"
                },
                "config_profile_contact": {
                    "type": "string"
                },
                "config_profile_url": {
                    "type": "string"
                }
            }
        },
        "generic_options": {
            "title": "Generic options",
            "type": "object",
            "fa_icon": "fas fa-file-import",
            "description": "Less common options for the pipeline, typically set in a config file.",
            "help_text": "These options are common to all nf-core pipelines and allow you to customise some of the core preferences for how the pipeline runs.\n\nTypically these options would be set in a Nextflow config file loaded for all pipeline runs, such as `~/.nextflow/config`.",
            "properties": {
                "version": {
                    "type": "boolean",
                    "description": "Display version and exit.",
                    "fa_icon": "fas fa-question-circle",
                    "hidden": true
                },
                "trace_report_suffix": {
                    "type": "string",
                    "fa_icon": "far calendar",
                    "description": "Suffix to add to the trace report filename. Default is the date and time in the format yyyy-MM-dd_HH-mm-ss.",
                    "hidden": true
                }
            }
        }
    },
    "allOf": [
        {
            "$ref": "#/$defs/input_output_options"
        },
        {
            "$ref": "#/$defs/basecalling_demultiplexing"
        },
        {
            "$ref": "#/$defs/genome_assembly"
        },
        {
            "$ref": "#/$defs/genome_alignment"
        },
        {
            "$ref": "#/$defs/resources"
        },
        {
            "$ref": "#/$defs/boilerplate"
        },
        {
            "$ref": "#/$defs/generic_options"
        }
    ]
}
